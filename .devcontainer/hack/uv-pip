#!/bin/bash

echo "Run uv pip instead of pip"

if [ -z "$VIRTUAL_ENV" ]; then
    echo "uv-pip: VIRTUAL_ENV is not set" >&2
    exit 1
fi

case "$VIRTUAL_ENV" in
    /*) ;;
    *)
        echo "uv-pip: VIRTUAL_ENV must be an absolute path: $VIRTUAL_ENV" >&2
        exit 1
        ;;
esac

VENV_PARENT="$(dirname "$VIRTUAL_ENV")"

mkdir -p "$VENV_PARENT" || exit 1

# Use standard python3 venv (instead of uv venv) to avoid the _virtualenv.pth startup hook
# that uv venv installs, which adds import overhead on every Python invocation at runtime.
# uv pip is still used for fast package installation.
if [ ! -d "$VIRTUAL_ENV" ]; then
    python3 -m venv --without-pip "$VIRTUAL_ENV" || exit 1
elif [ "$UV_PIP_CLEAR_VENV" = "1" ]; then
    python3 -m venv --without-pip --clear "$VIRTUAL_ENV" || exit 1
fi

if [ "$1" = "install" ]; then
    # Install with --compile-bytecode to ensure fast module loading at runtime
    uv pip install --compile-bytecode "${@:2}"
    # Remove any _virtualenv startup hooks that may have been injected
    find "${VIRTUAL_ENV}/lib" -name '_virtualenv.pth' -delete 2>/dev/null || true
    find "${VIRTUAL_ENV}/lib" -name '_virtualenv.py' -delete 2>/dev/null || true
    # Ensure complete bytecode compilation (belt-and-suspenders)
    python3 -m compileall -q --invalidation-mode checked-hash "${VIRTUAL_ENV}/lib" 2>/dev/null || true
else
    uv pip "$@"
fi
